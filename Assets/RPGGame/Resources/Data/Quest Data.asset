  quests:
  - questID: 1
    questTitle: "\uBD89\uC740 \uAC01\uC131"
    questDescription: "\uC138\uB9AC\uB098\uC5D0\uAC8C \uC0AC\uC815\uC744 \uB4E3\uACE0 \uCD08\uC2EC\uC790\uC758 \uC18C\uAD74\uB85C \uAC00\uC11C \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD55C \uB4A4 \uB3CC\uC544\uC628\uB2E4"
    objectiveLabel: "\uCD08\uC2EC\uC790\uC758 \uC18C\uAD74 \uBAAC\uC2A4\uD130 \uCC98\uCE58"
    type: 1
    targetType: 6
    countToComplete: 10
    zoneName: "\uCD08\uC2EC\uC790\uC758 \uC18C\uAD74"
    exp: 100
    rewardGold: 100
    rewardItemDisplayName: "\uD558\uAE09 \uCCB4\uB825 \uBB3C\uC57D"
    rewardItemCount: 3
    rewardItem: {fileID: 11400000, guid: d96aae15df0c241babb8a76194217efe, type: 2}
    category: 0
    giverNpcID: 1
    turnInNpcID: 1
    prerequisiteQuestIDs: 
    monsterLevel: 1
    questBeginText: "\uc815\uc2e0\uc774 \ub4dc\uc2dc\ub098\uc694? \ubd89\uc740 \ube44 \uc18d\uc5d0 \uc4f0\ub7ec\uc838 \uacc4\uc2e0 \uac78 \ub9c8\uc744 \uc0ac\ub78c\ub4e4\uc774 \ub370\ub824\uc654\uc5b4\uc694.|[\ubd09\uc778\uc790] \uc5ec\uae34... \uc5b4\ub514\uc8e0? \uc81c\uac00 \uc65c \uc774\uacf3\uc5d0...|\uc5ec\uae34 \ubc14\uc5d8\uc2a4\ub77c \ub300\ub959\uc758 \ub9c8\uc9c0\ub9c9 \ub9c8\uc744\uc774\uc5d0\uc694. \ub2e4\ub978 \ub9c8\uc744\ub4e4\uc740 \uc804\ubd80 \uce68\ub7b5\ub2f9\ud588\uc5b4\uc694.|[\ubd09\uc778\uc790] \uce68\ub7b5\ub2f9\ud588\ub2e4\uace0\uc694..? \ub3c4\ub300\uccb4 \ub204\uac00 \uc774\ub7f0 \uc9d3\uc744...|\uc9c0\uae08\uc740 \uc124\uba85\ud560 \uc2dc\uac04\uc774 \uc5c6\uc5b4\uc694! \uc790\ub77c\ud1a4\uc758 \uc2ec\ubcf5\ub4e4\uc774 \ucd08\uc2ec\uc790\uc758 \uc18c\uad74\uc5d0\uc11c \ub9c8\uc744 \uc785\uad6c\uae4c\uc9c0 \ubab0\ub824\uc624\uace0 \uc788\uc5b4\uc694.|\ucd08\uc2ec\uc790\uc758 \uc18c\uad74\ub85c \uac00\uc11c \ub140\uc11d\ub4e4\uc744 \ucc98\uce58\ud574 \uc8fc\uc138\uc694.|[\ubd09\uc778\uc790] \uc81c\uac00 \ubb34\uc2a8 \uc218\ub85c...|\uac71\uc815 \ub9c8\uc138\uc694. \ub2f9\uc2e0\uc740 \uc544\uc5d8\ube0c\ub9ac\uc2a4\uc758 \ud53c\ub97c \uac00\uc9c0\uace0 \uc788\uc73c\ub2c8\uae4c\uc694.|[\ubd09\uc778\uc790] \uc544\uc5d8... \ube0c\ub9ac\uc2a4?"
    questProgressText: "\ub9c8\uc871\ub4e4\uc744 \ucc98\uce58\ud558\uace0 \ub3cc\uc544\uc640 \uc8fc\uc138\uc694."
    questCompleteText: "\ubb34\uc0ac\ud788 \ub3cc\uc544\uc624\uc168\uad70\uc694!|[\ubd09\uc778\uc790] \ub188\ub4e4\uc740 \ub9c8\uc744\uc744 \ub178\ub9b0 \uac8c \uc544\ub2c8\uc5c8\uc5b4\uc694. \uc5b4\ub518\uac00\ub97c \ud5a5\ud574 \uc6c0\uc9c1\uc774\uace0 \uc788\uc5c8\uc5b4\uc694.|\ube14\ub7ec\ub4dc\uc0dd\ud140\uc73c\ub85c \ud5a5\ud558\uace0 \uc788\uc5b4\uc694. \uc790\ub77c\ud1a4\uc744 \uac00\ub454 \ubd09\uc778\uc774 \uc788\ub294 \uacf3\uc774\uc8e0.|\ubd09\uc778\uc774 \uc870\uae08\uc529 \ubb34\ub108\uc9c0\uace0 \uc788\uc5b4\uc694. \ub2f9\uc2e0\uc758 \ud798\uc744 \ube4c\ub824 \uc8fc\uc138\uc694.|\uc544\uc5d8\ube0c\ub9ac\uc2a4\ub294 \uadf8 \ubd09\uc778\uc744 \ub9cc\ub4e0 \uc77c\uc871\uc774\uc5d0\uc694. \uc9c0\uae08\uc740 \ub2f9\uc2e0\uc774 \uadf8 \ub9c8\uc9c0\ub9c9 \ud6c4\uc190\uc774\uace0\uc694.|[\ubd09\uc778\uc790] \uc81c\uac00... \uadf8 \ub9c8\uc9c0\ub9c9 \ud6c4\uc190\uc774\ub77c\uace0\uc694?|\uc6b0\uc120 \uc0c1\uc778 \uce74\uc774\ub4dc\ub85c\uc2a4\ub97c \ucc3e\uc544\uac00 \ubcf4\uc138\uc694. \ub3c4\uc6c0\uc774 \ub420 \uac70\uc608\uc694."
    questDeclineText: ""
    autoAccept: 1
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 2
    questTitle: "\uBD89\uC740 \uBE44\uC758 \uD754\uC801"
    questDescription: "\ucd08\uc2ec\uc790\uc758 \uc18c\uad74 \ubaac\uc2a4\ud130\uc5d0\uac8c\uc11c \ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 10\uac1c\ub97c \ubaa8\uc544 \uc138\ub9ac\ub098\uc5d0\uac8c \uac00\uc838\uac04\ub2e4"
    objectiveLabel: "\ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 \uc218\uc9d1"
    type: 4
    targetType: 6
    countToComplete: 10
    zoneName: "\uCD08\uC2EC\uC790\uC758 \uC18C\uAD74"
    exp: 250
    rewardGold: 150
    rewardItemDisplayName: "\uAC15\uD654\uC11D"
    rewardItemCount: 2
    rewardItem: {fileID: 11400000, guid: b14f9bc4527cc4a4d9fc67f980ab6a60, type: 2}
    collectItem: {fileID: 11400000, guid: 49c7b34132bd4df2aaca975f452f0284, type: 2}
    category: 0
    giverNpcID: 1
    turnInNpcID: 1
    prerequisiteQuestIDs: 09000000i
    monsterLevel: 1
    questBeginText: "\uc4f0\ub7ec\uc9c4 \ub9c8\uc871\ub4e4\uc774 \ubd89\uc740 \uacb0\uc815\uc744 \ub0a8\uaca8\uc694. '\ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01'\uc774\ub77c\ub294 \uac70\uc608\uc694.|\ubd09\uc778\ubb38\uc744 \uc5ec\ub294 \uc5f4\uc1e0\uc774\uc790, \ubd09\uc778\uc744 \uc644\uc131\ud560 \uc7ac\ub8cc\uc774\uae30\ub3c4 \ud574\uc694.|\ucd08\uc2ec\uc790\uc758 \uc18c\uad74\uc5d0\uc11c 10\uac1c\ub9cc \uad6c\ud574 \uc8fc\uc2dc\uaca0\uc5b4\uc694?"
    questProgressText: "\ub9c8\uc871\ub4e4\uc744 \ucc98\uce58\ud558\uba74 \uc5bb\uc744 \uc218 \uc788\uc5b4\uc694. 10\uac1c\ub97c \ubaa8\uc544 \uc8fc\uc138\uc694."
    questCompleteText: "\uac10\uc0ac\ud574\uc694. \uc774 \uc870\uac01\uc5d0\uc11c \ube14\ub7ec\ub4dc\uc0dd\ud140\uc758 \uae30\uc6b4\uc774 \ub290\uaef4\uc838\uc694.|\ud558\uc9c0\ub9cc \uc774 \uc815\ub3c4\ub85c\ub294 \ubd80\uc871\ud574\uc694. \ub354 \uae4a\uc740 \uacf3, \ud669\ubb34\uc9c0 \ub3d9\uad74\uc5d0 \uc870\uac01\uc774 \ub9ce\uc774 \uc788\uc744 \uac70\uc608\uc694.|\uadf8\uacf3\uc73c\ub85c \uac00\uae30 \uc804\uc5d0, \ub2f9\uc2e0\uc744 \ub354 \uac15\ud558\uac8c \ud574 \uc904 \uc0ac\ub78c\uc744 \uc18c\uac1c\ud574 \ub4dc\ub9b4\uac8c\uc694.|\ub300\uc7a5\uc7a5\uc774 \uac00\ub860\uc5d0\uac8c \ud55c\ubc88 \uac00 \ubcf4\uc138\uc694."
    questDeclineText: "\ubb34\ub9ac\ud558\uc9c0 \uc54a\uc73c\uc154\ub3c4 \ub3fc\uc694. \ud558\uc9c0\ub9cc \uc2dc\uac04\uc774 \ub9ce\uc9c0\ub294 \uc54a\uc544\uc694. \uc900\ube44\ub418\uba74 \ub2e4\uc2dc \uc640 \uc8fc\uc138\uc694."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 3
    questTitle: "\uBD09\uC778\uC758 \uADE0\uC5F4"
    questDescription: "\uCE74\uC774\uB4DC\uB85C\uC2A4\uC758 \uBD80\uD0C1\uC73C\uB85C \uD669\uBB34\uC9C0 \uB3D9\uAD74 \uC785\uAD6C\uC758 \uBAAC\uC2A4\uD130\uB97C \uC815\uB9AC\uD558\uACE0 \uBD09\uC778\uC758 \uC0C1\uD0DC\uB97C \uD655\uC778\uD55C\uB2E4"
    objectiveLabel: "\uD669\uBB34\uC9C0 \uB3D9\uAD74 \uBAAC\uC2A4\uD130 \uCC98\uCE58"
    type: 1
    targetType: 8
    countToComplete: 15
    zoneName: "\uD669\uBB34\uC9C0 \uB3D9\uAD74"
    exp: 350
    rewardGold: 200
    rewardItemDisplayName: "\uAC15\uD654\uC11D"
    rewardItemCount: 2
    rewardItem: {fileID: 11400000, guid: b14f9bc4527cc4a4d9fc67f980ab6a60, type: 2}
    category: 0
    giverNpcID: 2
    turnInNpcID: 2
    prerequisiteQuestIDs: 0a000000i
    monsterLevel: 2
    questBeginText: "\ub2e4\uc2dc \uc654\uad70, (\ub2c9\ub124\uc784).|\ud669\ubb34\uc9c0 \ub3d9\uad74\uc5d0 \ub4e4\uc5b4\uac08 \uc900\ube44\ub294 \ub9c8\ucce4\ub098? \uadf8\uacf3\uc5d0\uc11c \ubd09\uc778\uc5d0 \ub300\ud55c \ud78c\ud2b8\ub97c \uc5bb\uc744 \uc218 \uc788\uc744 \uac70\ub2e4.|\ud669\ubb34\uc9c0 \ub3d9\uad74\uc5d0 \uac00\uc11c \ub9c8\uc871 15\ub9c8\ub9ac\ub97c \ucc98\uce58\ud558\uace0 \uc640\ub77c."
    questProgressText: "\ud669\ubb34\uc9c0 \ub3d9\uad74\uc774 \uc608\uc804 \ubaa8\uc2b5\uc744 \ub418\ucc3e\uc744 \uc218 \uc788\uc744\uae4c?"
    questCompleteText: "[\ubd09\uc778\uc790] \ub9c8\uc871\ub4e4\uc774 \ub3d9\uad74 \uc548\ucabd\uc5d0\uc11c \uc0c8\uc5b4 \ub098\uc624\ub294 \ubd09\uc778\uc758 \uae30\uc6b4\uc744 \ube68\uc544\ub4e4\uc774\uace0 \uc788\uc5c8\uc5b4\uc694.|\ubd09\uc778\uc758 \uae30\uc6b4\uc744 \uba39\uace0 \uc788\uc5c8\uad70. \uc608\uc0c1\ubcf4\ub2e4 \uc2ec\uac01\ud574.|\uc218\uace0\ud588\ub2e4, (\ub2c9\ub124\uc784). \ub2e4\uc74c \uc77c\uc744 \ub9d0\ud574 \uc8fc\uc9c0."
    questDeclineText: "\uc544\uc9c1 \uc900\ube44\uac00 \ub35c \ub410\ub098? \uc11c\ub450\ub974\ub2e4 \uc8fd\ub294 \uac83\ubcf4\ub2e8 \ub0ab\uc9c0. \uc900\ube44\ub418\uba74 \ub9d0\ud574\ub77c."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 4
    questTitle: "\uC9C0\uD558\uC131\uC758 \uBB38"
    questDescription: "\ud669\ubb34\uc9c0 \ub3d9\uad74\uc758 \ubaac\uc2a4\ud130\uc5d0\uac8c\uc11c \ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 15\uac1c\ub97c \ubaa8\uc544 \ubd09\uc778\ubb38\uc744 \uc5f0\ub2e4"
    objectiveLabel: "\ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 \uc218\uc9d1"
    type: 4
    targetType: 8
    countToComplete: 15
    zoneName: "\uD669\uBB34\uC9C0 \uB3D9\uAD74"
    exp: 500
    rewardGold: 250
    rewardItemDisplayName: "\uAC15\uD654\uC11D"
    rewardItemCount: 1
    rewardItem: {fileID: 11400000, guid: b14f9bc4527cc4a4d9fc67f980ab6a60, type: 2}
    collectItem: {fileID: 11400000, guid: 49c7b34132bd4df2aaca975f452f0284, type: 2}
    category: 0
    giverNpcID: 2
    turnInNpcID: 2
    prerequisiteQuestIDs: 03000000i
    monsterLevel: 3
    questBeginText: "\uc138\ub9ac\ub098\uc5d0\uac8c \ube14\ub7ec\ub4dc\uc2a4\ud1a4\uc5d0 \uad00\ud55c \uc598\uae30\ub294 \ub4e4\uc5c8\uaca0\uc9c0?|[\ubd09\uc778\uc790] \ub124. \ub9c8\uc871\ub4e4\uc744 \ucc98\uce58\ud558\uba74 \uc5bb\uc744 \uc218 \uc788\ub2e4\uace0 \ub4e4\uc5c8\uc5b4\uc694.|\ub3d9\uad74 \uc548\ucabd\uc758 \ubd09\uc778\ubb38\uc740 \ub9c8\uacc4\uc758 \uacb0\uc815, \ube14\ub7ec\ub4dc\uc2a4\ud1a4\uc73c\ub85c \uc5f4\ub9b0\ub2e4. \uadf8 \ub108\uba38\uac00 \uc9c0\ud558\uc131\uc774\ub2e4.|\uadf8\uac78 \uc644\uc131\ud558\ub824\uba74 \uc870\uac01\ub4e4\uc744 \ubaa8\uc544\uc57c \ud558\uc9c0.|\ud669\ubb34\uc9c0 \ub3d9\uad74\ub85c \ub2e4\uc2dc \uac00\uc11c \ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 15\uac1c\ub97c \ubaa8\uc544 \uc640\ub77c."
    questProgressText: "\ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 15\uac1c\ub2e4."
    questCompleteText: "\uc774\uac78\ub85c \uc9c0\ud558\uc131\uc73c\ub85c \ud1b5\ud558\ub294 \ubd09\uc778\ubb38\uc774 \uc5f4\ub9b0\ub2e4.|\uc5ec\uae30\uc11c\ubd80\ud130\uac00 \uc9c4\uc9dc\ub2e4."
    questDeclineText: "\uc870\uac01\uc744 \ub354 \ubaa8\uc544\uc57c \ud558\ub098? \uc11c\ub450\ub97c \ud544\uc694\ub294 \uc5c6\uc9c0\ub9cc, \ub9c8\uc871\ub4e4\uc740 \uae30\ub2e4\ub824 \uc8fc\uc9c0 \uc54a\ub294\ub2e4."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 5
    questTitle: "\uC120\uBD09\uB300\uC7A5\uC758 \uCD5C\uD6C4"
    questDescription: "\uBB34\uB108\uC9C4 \uC131\uCC44 \uD130\uC5D0\uC11C \uC790\uB77C\uD1A4\uC758 \uC120\uBD09\uB300\uC7A5 \uB4DC\uB809 \uB9D0\uB85C\uC2A4\uC640 \uB300\uACB0\uD55C\uB2E4"
    objectiveLabel: "\uB4DC\uB809 \uB9D0\uB85C\uC2A4 \uCC98\uCE58"
    type: 1
    targetType: 9
    countToComplete: 1
    zoneName: 
    exp: 1500
    rewardGold: 500
    rewardItemDisplayName: "\uBD88\uBA78\uC758 \uC131\uAC80"
    rewardItemCount: 1
    rewardItem: {fileID: 11400000, guid: 75aa0fdb6532c4e8abd2a79e4fe69411, type: 2}
    category: 0
    giverNpcID: 2
    turnInNpcID: 2
    prerequisiteQuestIDs: 04000000i
    monsterLevel: 3
    questBeginText: "\uc9c0\ud558\uc131\uc740 \uc624\ub798\uc804 \ucc9c\uacc4\uc5d0\uc11c \ucd94\ub77d\ud574 \uc774 \ub545 \uc544\ub798 \ubb3b\ud78c, \ucc9c\uc778\ub4e4\uc758 \uc131\uc774\ub2e4.|\uc9c0\uae08\uc740 \uc790\ub77c\ud1a4\uc758 \ud558\uc218\uc778 \ub4dc\ub809 \ub9d0\ub85c\uc2a4\uac00 \uc9c0\ubc30\ud558\uace0 \uc788\uc9c0.|[\ubd09\uc778\uc790] \uadf8\uac78 \uc5b4\ub5bb\uac8c \uc544\uc138\uc694?|\uc7a5\uc0ac\uafbc\uc740 \uc18c\ubb38\uc5d0 \ubc1d\uc740 \ubc95\uc774\uc57c. \uc624\ub798 \ub5a0\ub3cc\ub2e4 \ubcf4\uba74 \uc774\ub7f0 \uc598\uae30\ub3c4 \uc8fc\uc6cc\ub4e3\uac8c \ub418\uc9c0.|\ub188\uc740 \uc9c0\uae08 \ubd09\uc778\uc744 \uae68\ub728\ub9ac\ub294 \uc758\uc2dd\uc744 \uce58\ub974\uace0 \uc788\ub2e4. \uc758\uc2dd\uc774 \ub05d\ub098\uae30 \uc804\uc5d0 \ub9c9\uc544\uc57c \ud574.|\uc9c0\ud558\uc131 \uae4a\uc740 \uacf3, \ubb34\ub108\uc9c4 \uc131\ucc44 \ud130\uc5d0 \uac00\uc11c \uc758\uc2dd\uc744 \ub9c9\uc544 \uc8fc\uaca0\ub098?"
    questProgressText: "\ub4dc\ub809 \ub9d0\ub85c\uc2a4\ub294 \ubb34\ub108\uc9c4 \uc131\ucc44 \ud130\uc5d0 \uc788\ub2e4. \ubb34\uc6b4\uc744 \ube48\ub2e4."
    questCompleteText: "\ub4dc\ub809 \ub9d0\ub85c\uc2a4\ub97c \uc4f0\ub7ec\ub728\ub838\uad70!|[\ubd09\uc778\uc790] \ub188\uc774 \uc8fd\uae30 \uc9c1\uc804\uc5d0 \"\uc790\ub77c\ud1a4 \ub2d8\uc758 \uac01\uc131\uc740 \uc774\ubbf8 \uc2dc\uc791\ub410\ub2e4\"\uace0 \ud588\uc5b4\uc694.|\uc5ed\uc2dc \uadf8\ub7ac\uad70. \uc774\uc81c \uc2dc\uac04\uc774 \uc5c6\uc5b4.|\uc138\ub9ac\ub098\uc5d0\uac8c \uac00 \ubd10\ub77c. \ucd5c\ud6c4\uc758 \uc218\ub2e8\uc774 \uc788\uc744 \uac70\ub2e4."
    questDeclineText: "\ub450\ub824\uc6b4 \uac74\uac00? \ubd80\ub044\ub7ec\uc6b4 \uc77c\uc740 \uc544\ub2c8\ub2e4. \ub2e4\ub9cc \uc758\uc2dd\uc740 \uae30\ub2e4\ub824 \uc8fc\uc9c0 \uc54a\uc544. \ub9c8\uc74c\uc744 \uc815\ud558\uba74 \ub2e4\uc2dc \uc624\ub108\ub77c."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
