    questBeginText: "\uce74\uc774\ub4dc\ub85c\uc2a4\uc5d0\uac8c \ub4e4\uc73c\uc168\uad70\uc694. \ucd5c\ud6c4\uc758 \uc218\ub2e8\uc740 \uc544\uc9c1 \ubd09\uc778\uc774 \uc644\uc804\ud788 \ud480\ub9ac\uc9c0 \uc54a\uc740 \uc790\ub77c\ud1a4\uc744 \uc4f0\ub7ec\ub728\ub9ac\uace0, \ube14\ub7ec\ub4dc\uc2a4\ud1a4\uc73c\ub85c \ubd09\uc778\uc744 \uc644\uc131\ud558\ub294 \uac70\uc608\uc694.|[\ubd09\uc778\uc790] \uc870\uac01\ub4e4\uc744 \ubaa8\uc544 \ube14\ub7ec\ub4dc \uc2a4\ud1a4\uc744 \uc644\uc131\ud558\ub294 \uac70\uad70\uc694.|\ub124 \ub9de\uc544\uc694. \uadf8\ub7ec\uae30 \uc704\ud574\uc120 \uc21c\ub3c4 \ub192\uc740 \uc870\uac01\uc774 \ub354 \ud544\uc694\ud574\uc694. \uc2ec\uc5f0\uc758 \uc18c\uad74\uc5d0 \uc788\uc5b4\uc694.|\ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 20\uac1c\ub97c \uad6c\ud574 \uc8fc\uc2dc\uaca0\uc5b4\uc694?"
    questProgressText: "\uc870\uc2ec\ud558\uc138\uc694. \ub9c8\uc871\uc774 \ud6e8\uc52c \uac15\ud574\uc694. \ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01 20\uac1c\uac00 \ud544\uc694\ud574\uc694."
    questCompleteText: "\ub4e4\ub9ac\uc138\uc694? \uc81c \uae30\ub3c4\uac00 \ub2ff\uc558\uc5b4\uc694.|\ube14\ub7ec\ub4dc\uc0dd\ud140\uc5d0\uc11c \ubd09\uc778\uc744 \uc9c4\ud589\ud560 \uc900\ube44\ub294 \ub05d\ub0ac\uc5b4\uc694.|\uc774\uc81c \uc815\ub9d0 \uc2dc\uac04\uc774 \uc5c6\uc5b4\uc694."
    questDeclineText: "\ub9ce\uc774 \uc9c0\uce58\uc168\uaca0\uc8e0. \ud558\uc9c0\ub9cc \uc2dc\uac04\uc774 \uc5bc\ub9c8 \uc5c6\uc5b4\uc694. \uc900\ube44\ub418\uba74 \ub2e4\uc2dc \ub9d0\uc500\ud574 \uc8fc\uc138\uc694."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 7
    questTitle: "\uBD09\uC778\uC790\uC758 \uACB0\uC804"
    questDescription: "\uBE14\uB7EC\uB4DC\uC0DD\uD140\uC5D0\uC11C \uC790\uB77C\uD1A4\uACFC \uCD5C\uD6C4\uC758 \uACB0\uC804\uC744 \uBC8C\uC774\uACE0 \uBD89\uC740 \uC218\uC815 \uC655\uC88C\uC5D0\uC11C \uBD09\uC778\uC744 \uC644\uC131\uD55C\uB2E4"
    objectiveLabel: "\uC790\uB77C\uD1A4 \uCC98\uCE58"
    type: 1
    targetType: 10
    countToComplete: 1
    zoneName: 
    exp: 7000
    rewardGold: 2000
    rewardItemDisplayName: 
    rewardItemCount: 0
    rewardItem: {fileID: 0}
    category: 0
    giverNpcID: 1
    turnInNpcID: 0
    prerequisiteQuestIDs: 06000000i
    monsterLevel: 5
    questBeginText: "\uc790\ub77c\ud1a4\uc774 \ub208\uc744 \ub5b4\uc5b4\uc694. \ubd09\uc778\uc740 \uc544\uc5d8\ube0c\ub9ac\uc2a4\uc758 \ud53c\ub97c \uc774\uc740 (\ub2c9\ub124\uc784)\ub2d8, \ub2f9\uc2e0\ub9cc\uc774 \uc644\uc131\ud560 \uc218 \uc788\uc5b4\uc694.|\uc9c0\uae08\uae4c\uc9c0 \ubaa8\uc740 \ube14\ub7ec\ub4dc\uc2a4\ud1a4 \uc870\uac01\ub4e4\ub85c \ube14\ub7ec\ub4dc\uc2a4\ud1a4\uc744 \uc644\uc131\ud588\uc5b4\uc694. \ubc1b\uc544 \uc8fc\uc138\uc694.|\ube14\ub7ec\ub4dc\uc0dd\ud140\uc5d0\uc11c \uc790\ub77c\ud1a4\uc744 \uc4f0\ub7ec\ub728\ub9ac\uba74 \ubd89\uc740 \ube5b\uc774 \uc0dd\uae38 \uac70\uc608\uc694. \uadf8 \ube5b\uc744 \ub530\ub77c \ube14\ub7ec\ub4dc\uc2a4\ud1a4\uc73c\ub85c \ubd09\uc778\uc744 \uc644\uc131\ud558\ub294 \uac70\uc608\uc694.|\uc774 \ub9c8\uc9c0\ub9c9 \uc2f8\uc6c0\uc744 \ub9e1\uc544 \uc8fc\uc2dc\uaca0\uc5b4\uc694?"
    questProgressText: "\uc790\ub77c\ud1a4\uc740 \uc544\uc9c1 \ube14\ub7ec\ub4dc\uc0dd\ud140\uc5d0 \uc788\uc5b4\uc694. \ud55c \ubc88 \uc4f0\ub7ec\ub728\ub824\ub3c4 \ub05d\ub098\uc9c0 \uc54a\uc744 \uac70\uc608\uc694. \ubc29\uc2ec\ud558\uc9c0 \ub9c8\uc138\uc694."
    questCompleteText: "\ubd09\uc778\uc774... \uc644\uc131\ub410\uc5b4\uc694.|\uace0\ub9c8\uc6cc\uc694, (\ub2c9\ub124\uc784)\ub2d8."
    questDeclineText: "\ucda9\ubd84\ud788 \uc900\ube44\ud558\uc138\uc694. \uc774\ubc88\uc774 \ub9c8\uc9c0\ub9c9\uc774\ub2c8\uae4c\uc694. \uc900\ube44\ub418\uba74 \ub9d0\uc500\ud574 \uc8fc\uc138\uc694."
    autoAccept: 0
    acceptItem: {fileID: 11400000, guid: 3e84565cd91b43b5b4ccb66cb074ed74, type: 2}
    acceptItemCount: 1
  - questID: 8
    questTitle: "\uCCAB \uBC88\uC9F8 \uBB3C\uC57D"
    questDescription: "\uCE74\uC774\uB4DC\uB85C\uC2A4\uC758 \uC0C1\uC810\uC5D0\uC11C \uBB3C\uC57D\uC744 \uAD6C\uB9E4\uD558\uACE0 \uB2E8\uCD95\uD0A4 \uC2AC\uB86F\uC5D0 \uB4F1\uB85D\uD55C\uB2E4"
    objectiveLabel: "\uBB3C\uC57D \uAD6C\uB9E4 \uD6C4 \uB2E8\uCD95\uD0A4 \uB4F1\uB85D"
    type: 5
    targetType: -1
    countToComplete: 2
    zoneName: 
    exp: 60
    rewardGold: 50
    rewardItemDisplayName: "\uD558\uAE09 \uCCB4\uB825 \uBB3C\uC57D"
    rewardItemCount: 2
    rewardItem: {fileID: 11400000, guid: d96aae15df0c241babb8a76194217efe, type: 2}
    category: 0
    giverNpcID: 2
    turnInNpcID: 2
    prerequisiteQuestIDs: 01000000i
    monsterLevel: 0
    questBeginText: "\uc138\ub9ac\ub098\uac00 \ubcf4\ub0c8\ub098? \uc544\uc5d8\ube0c\ub9ac\uc2a4\uc758 \ud6c4\uc190\uc744 \uc9c1\uc811 \ubcf4\ub294 \uac74 \uc624\ub79c\ub9cc\uc774\uad70.|[\ubd09\uc778\uc790] \uc548\ub155\ud558\uc138\uc694.|\uc2f8\uc6b0\ub7ec \ub098\uac00\uae30 \uc804\uc5d4 \ub0b4 \uac00\uac8c\uc5d0\uc11c \ud544\uc694\ud55c \uac83\ub4e4\uc744 \ucc59\uaca8\ub77c.|\uba3c\uc800 \ubb3c\uc57d\uc744 \ud558\ub098 \uad6c\uc785\ud574\uc11c \ub2e8\ucd95\ud0a4\uc5d0 \uc62c\ub824 \ubcf4\uaca0\ub098?"
    questProgressText: "\ubb3c\uc57d\uc744 \uc0ac\uc11c \ub2e8\ucd95\ud0a4\uc5d0 \uc62c\ub9ac\uace0 \uc640\ub77c. \uc678\uc0c1\uc740 \uc548 \ubc1b\ub294\ub2e4."
    questCompleteText: "\uc88b\uc544. \uc798\ud588\uc5b4. \ubb3c\uc57d\uc740 \ub109\ub109\ud558\uac8c \uad6c\ube44\ud574 \ub450\ub294 \uac8c \uc88b\uc744 \uac70\ub2e4.|\uc774\uc81c \uc138\ub9ac\ub098\uc5d0\uac8c \uac00\uc11c \uc2a4\ud0ac\uc5d0 \ub300\ud574 \ubc30\uc6b0\uace0 \uc624\ub108\ub77c."
    questDeclineText: "\uc2eb\uc73c\uba74 \ub9d0\uace0. \ubb3c\uc57d \uc5c6\uc774 \ub098\uac14\ub2e4\uac00 \uc8fd\uc5b4\ub3c4 \ub0b4 \ud0d3\uc740 \uc544\ub2c8\ub2e4. \ub9c8\uc74c\uc774 \ubc14\ub00c\uba74 \ub2e4\uc2dc \uc640\ub77c."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 9
    questTitle: "\uC2A4\uD0AC\uC758 \uAE30\uCD08"
    questDescription: "\uC2A4\uD0AC\uCC3D\uC744 \uC5F4\uC5B4 \uC2A4\uD0AC\uC744 \uBC30\uC6B0\uACE0 \uB2E8\uCD95\uD0A4 \uC2AC\uB86F\uC5D0 \uB4F1\uB85D\uD55C\uB2E4"
    objectiveLabel: "\uC2A4\uD0AC \uC2B5\uB4DD \uD6C4 \uB2E8\uCD95\uD0A4 \uB4F1\uB85D"
    type: 6
    targetType: -1
    countToComplete: 2
    zoneName: 
    exp: 100
    rewardGold: 80
    rewardItemDisplayName: "\uC0C1\uAE09 \uCCB4\uB825 \uBB3C\uC57D"
    rewardItemCount: 1
    rewardItem: {fileID: 11400000, guid: 46573ee05f9624b1c9eaf9a46b9c9c4c, type: 2}
    category: 0
    giverNpcID: 1
    turnInNpcID: 1
    prerequisiteQuestIDs: 08000000i
    monsterLevel: 0
    questBeginText: "\uc798 \ub2e4\ub140\uc624\uc168\ub098\uc694? \uc774\ubc88\uc5d4 \uc2a4\ud0ac\uc5d0 \ub300\ud574 \uc54c\ub824 \ub4dc\ub9b4\uac8c\uc694.|\uc6d0\ud558\ub294 \uc2a4\ud0ac\uc744 \ud558\ub098 \ubc30\uc6b0\uace0 \ub2e8\ucd95\ud0a4\uc5d0 \uc62c\ub824 \ubcf4\uc2dc\uaca0\uc5b4\uc694?"
    questProgressText: "\uc2a4\ud0ac\uc744 \ud558\ub098 \ubc30\uc6b0\uace0 \ub2e8\ucd95\ud0a4\uc5d0 \uc62c\ub824 \uc8fc\uc138\uc694."
    questCompleteText: "\uc88b\uc544\uc694! \uc2a4\ud0ac\uc744 \uc4f0\uba74 MP\uac00 \uc18c\ubaa8\ub418\ub2c8, \ub0a8\uc740 MP\ub97c \uc798 \ud655\uc778\ud558\uace0 \uc0ac\uc6a9\ud558\uc138\uc694.|\ub610 MP\ub294 \uae30\ubcf8 \uacf5\uaca9\uc73c\ub85c \ud68c\ubcf5\ud560 \uc218 \uc788\uc5b4\uc694!|\uc774\uc81c \ubd80\ud0c1\ub4dc\ub9b4 \uc77c\uc774 \uc788\uc5b4\uc694."
    questDeclineText: "\uc544\uc9c1 \uc900\ube44\uac00 \uc548 \ub418\uc168\uad70\uc694. \uad1c\ucc2e\uc544\uc694, \uc900\ube44\ub418\uba74 \ub2e4\uc2dc \ub9d0\uc500\ud574 \uc8fc\uc138\uc694."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
  - questID: 10
    questTitle: "\uC7A5\uBE44 \uC815\uBE44"
    questDescription: "\uD669\uBB34\uC9C0 \uB3D9\uAD74\uB85C \uAC00\uAE30 \uC804\uC5D0 \uB300\uC7A5\uC7A5\uC774 \uAC00\uB860\uC5D0\uAC8C \uC7A5\uBE44\uB97C \uAC15\uD654\uD55C\uB2E4"
    objectiveLabel: "\uC7A5\uBE44 1\uD68C \uAC15\uD654"
    type: 7
    targetType: -1
    countToComplete: 1
    zoneName: 
    exp: 150
    rewardGold: 150
    rewardItemDisplayName: "\uAC15\uD654\uC11D"
    rewardItemCount: 1
    rewardItem: {fileID: 11400000, guid: b14f9bc4527cc4a4d9fc67f980ab6a60, type: 2}
    category: 0
    giverNpcID: 3
    turnInNpcID: 3
    prerequisiteQuestIDs: 02000000i
    monsterLevel: 0
    questBeginText: "\uc138\ub9ac\ub098\uc5d0\uac8c \uc598\uae30\ub294 \ub4e4\uc5c8\ub2e4. \ub300\ucda9 \uc9d0\uc791\uc774 \uac00\ub294\uad70.|\ub2e4\uc74c\uc740 \ud669\ubb34\uc9c0 \ub3d9\uad74\ub85c \uac00\ub824\ub294 \uac70\uaca0\uc9c0.|[\ubd09\uc778\uc790] \ud669\ubb34\uc9c0 \ub3d9\uad74\uc740 \uc5b4\ub5a4 \uacf3\uc778\uac00\uc694?|\uc790\ub77c\ud1a4\uc5d0\uac8c \uc810\ub839\ub2f9\ud55c \uc9c0 \uc624\ub798\ub41c \ub545\uc774\ub2e4. \ub9e8\ubab8\uc73c\ub85c\ub294 \uc0b4\uc544\ub0a8\uae30 \ud798\ub4e4\uc9c0.|\ub0b4\uac00 \uc7a5\ube44\ub97c \uac15\ud654\ud574 \uc8fc\ub9c8. \uccab \uac15\ud654\uc5d0 \uc4f8 \uc7ac\ub8cc\ub294 \ub0b4\uac00 \ub300 \uc8fc\uc9c0. \ud55c\ubc88 \uac15\ud654\ud574 \ubcf4\uaca0\ub098?"
    questProgressText: "\uc7a5\ube44\ub97c \ud55c \ubc88 \uac15\ud654\ud574 \ubd10\ub77c. \uc7ac\ub8cc\ub294 \uc92c\ub2e4."
    questCompleteText: "\uc88b\uc544, \uc2f8\uc6b8 \ub9cc\ud55c \uaf34\uc774 \ub410\uad70.|\uac15\ud654\ub294 \ub2e8\uacc4\uac00 \uc624\ub97c\uc218\ub85d \ube44\uc6a9\uc774 \ub298\uace0 \ud655\ub960\uc774 \ub5a8\uc5b4\uc9c4\ub2e4. \uc2e0\uc911\ud558\uac8c \ud574\ub77c.|\uc0c1\uc778 \uce74\uc774\ub4dc\ub85c\uc2a4\uac00 \ub108\ud55c\ud14c \ud560 \ub9d0\uc774 \uc788\ub2e4\ub354\uad70. \uac00\uc11c \ub9cc\ub098 \ubd10\ub77c."
    questDeclineText: "\uc2eb\uc73c\uba74 \uad00\ub46c\ub77c. \ud558\uc9c0\ub9cc \uadf8 \uc7a5\ube44\ub85c \ub3d9\uad74\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uac74 \uc790\uc0b4\ud589\uc704\uc57c. \ub9c8\uc74c\uc774 \ubc14\ub00c\uba74 \uc640\ub77c."
    autoAccept: 0
    acceptItem: {fileID: 0}
    acceptItemCount: 1
