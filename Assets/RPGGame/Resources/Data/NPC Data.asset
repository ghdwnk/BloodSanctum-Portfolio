  m_Script: {fileID: 11500000, guid: 841488fe65f9f40cb8e59eeb1e46eaaf, type: 3}
  m_Name: NPC Data
  m_EditorClassIdentifier: Assembly-CSharp::RPGGame.NPCData
  attributes:
  - id: 1
    name: "\uC138\uB9AC\uB098"
    role: "\uC120\uAD6C\uC790"
    interactionSight: 2
    idleSmallTalk: "\uC774 \uB9C8\uC744\uB3C4 \uC5B8\uC820\uAC00\uB294 \uB2E4\uC2DC \uC608\uC804 \uBAA8\uC2B5\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uC744\uAE4C\uC694?"
    postEndingTalk: "\uBD09\uC778\uC740 \uC644\uC131\uB410\uC5B4\uC694. \uB2F9\uC2E0 \uB355\uBD84\uC5D0 \uB9C8\uC744\uC5D0\uB3C4 \uB2E4\uC2DC \uC544\uCE68\uC774 \uCC3E\uC544\uC654\uC8E0.|\uD558\uC9C0\uB9CC \uB2F9\uC2E0\uC758 \uD53C\uAC00 \uD750\uB974\uB294 \uD55C, \uBD89\uC740 \uBE44\uC758 \uAE30\uC5B5\uC740 \uC644\uC804\uD788 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694.|\uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uC774\uC81C \uC6B0\uB9AC\uB294 \uB354 \uC774\uC0C1 \uD63C\uC790\uAC00 \uC544\uB2C8\uB2C8\uAE4C\uC694."
  - id: 2
    name: "\uCE74\uC774\uB4DC\uB85C\uC2A4"
    role: "\uC0C1\uC778"
    interactionSight: 2
    idleSmallTalk: "\uC138\uC0C1\uC774 \uB9DD\uD574\uB3C4 \uC7A5\uC0AC\uB294 \uACC4\uC18D\uB3FC\uC57C\uC9C0."
    postEndingTalk: "\uBD09\uC778\uC774 \uC644\uC131\uB410\uC5B4\uB3C4 \uB188\uB4E4\uC758 \uC794\uB2F9\uC740 \uB0A8\uC544 \uC788\uB2E4. \uC0AC\uB0E5\uD130\uC5D0 \uB098\uAC00\uAE30 \uC804\uC5D4 \uAF2D \uB0B4 \uAC00\uAC8C\uC5D0 \uB4E4\uB7EC\uB77C.|\uB108 \uAC19\uC740 \uBD09\uC778\uC790\uAC00 \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uAD70. \uD544\uC694\uD55C \uAC74 \uBB50\uB4E0 \uC2F8\uAC8C \uB118\uACA8\uC8FC\uC9C0. \uC774\uBC88\uB9CC\uD07C\uC740 \uC9C4\uC2EC\uC774\uB2E4."
  - id: 3
    name: "\uAC00\uB860"
    role: "\uB300\uC7A5\uC7A5\uC774"
    interactionSight: 2
    idleSmallTalk: "\uAC15\uD654\uD310\uC774\uB098 \uD55C\uBC88 \uBCF4\uACE0 \uAC00."
    postEndingTalk: "\uBD09\uC778\uC774 \uC644\uC131\uB410\uB2E4\uB294 \uC18C\uBB38\uC5D0 \uC77C\uAC10\uC774 \uC3DF\uC544\uC9C0\uB294\uAD70. \uB124 \uAC80\uB3C4 \uB2E4\uC2DC \uC190\uBD10 \uC8FC\uB9C8.|\uC138\uC0C1\uC744 \uAD6C\uD55C \uAC80\uC774\uB77C\uBA74 \uADF8\uB9CC\uD07C \uB2E8\uB2E8\uD558\uAC8C \uBCBC\uB824 \uB46C\uC57C\uC9C0. \uC5B8\uC81C\uB4E0 \uAC15\uD654\uD310 \uC55E\uC73C\uB85C \uC640\uB77C."
