  m_Script: {fileID: 11500000, guid: 2c762ca911a914aa8bd6aec54689dc2a, type: 3}
  m_Name: LoadingTips
  m_EditorClassIdentifier: Assembly-CSharp::RPGGame.LoadingTipCollection
  tips:
  - "\uC218\uCC9C \uB144 \uC804, \uB9C8\uACC4\uC758 \uC808\uB300 \uAD70\uC8FC \uC790\uB77C\uD1A4\uC774
    \uBC14\uC5D8\uC2A4\uB77C\uB97C \uCE68\uACF5\uD588\uB2E4. \uACE0\uB300 \uC601\uC6C5\uB4E4\uC740
    \uC2A4\uC2A4\uB85C\uC758 \uD53C\uB97C \uC81C\uBB3C\uB85C \uC0BC\uC544 \uC131\uC5ED
    \uBE14\uB7EC\uB4DC\uC0DD\uD140\uC744 \uC138\uC6B0\uACE0 \uC790\uB77C\uD1A4\uC744
    \uBD09\uC778\uD558\uB294 \uB370 \uC131\uACF5\uD588\uB2E4."
  - "\uADF8\uB85C\uBD80\uD130 \uC218\uCC9C \uB144 \uD6C4, \uBD09\uC778\uC774 \uD754\uB4E4\uB9AC\uAE30
    \uC2DC\uC791\uD55C\uB2E4. \uBD89\uC740 \uBE44\uAC00 \uC3DF\uC544\uC9C0\uACE0,
    \uB9C8\uACC4\uC758 \uADE0\uC5F4\uC774 \uACF3\uACF3\uC5D0 \uC5F4\uB9AC\uBA70 \uC790\uB77C\uD1A4\uC758
    \uC2EC\uBCF5\uB4E4\uC774 \uCE68\uD22C\uD55C\uB2E4. \uB9C8\uC744\uC774 \uBD88\uD0C0\uACE0,
    \uC778\uAC04\uB4E4\uC740 \uD559\uC0B4\uB2F9\uD55C\uB2E4."
  - "\uD50C\uB808\uC774\uC5B4\uB294 \uACE0\uB300 \uC601\uC6C5\uC758 \uD608\uD1B5
    \uC544\uC5D8\uBE0C\uB9AC\uC2A4\uC871. \uCD5C\uD6C4\uC758 \uB9C8\uC744 \uC560\uC26C\uD5E4\uC774\uBE10\uC5D0\uC11C
    \uAC01\uC131\uD55C \uD50C\uB808\uC774\uC5B4\uB294 \uBE14\uB7EC\uB4DC\uC0DD\uD140
    \uCD5C\uC2EC\uBD80\uC5D0\uC11C \uC790\uB77C\uD1A4\uACFC \uCD5C\uD6C4\uC758 \uACB0\uC804\uC744
    \uBC8C\uC778\uB2E4."
  - "\u201C\uD53C\uB85C \uC138\uC6B4 \uBD09\uC778\uC740, \uD53C\uB85C\uB9CC \uC9C0\uD0AC
    \uC218 \uC788\uB2E4.\u201D"
  - "\uC704\uD611\uC801\uC778 \uC874\uC7AC\uB4E4\uC774 \uC5B4\uB460 \uC18D\uC5D0
    \uB3C4\uC0AC\uB9AC\uACE0 \uC788\uC73C\uB2C8 \uBC29\uC2EC\uD558\uC9C0 \uB9C8\uC138\uC694."
